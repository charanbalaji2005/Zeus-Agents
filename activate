#!/usr/bin/env bash
# ============================================================================
# venv-style activation of the Zeus dev environment for an interactive shell.
#
#   source ./activate       (bash / zsh, repo root)
#   source ./activate.fish  (fish)
#   .\activate.ps1          (PowerShell)
#
# Applies the composed pm env (PATH + tool vars) to the CURRENT shell, with
# save/restore: `deactivate` undoes exactly what activation changed.
#
# `zeus` becomes a shell function for this checkout. It runs only while the
# shell is inside this worktree and refuses outside it, so a sibling worktree
# keeps its own command. A prompt prefix names the worktree.
#
# Scripts and other processes do not source this: they run under
# `scripts/run-in-zeus-env`. Both build on scripts/_activation.sh.
#
# Sync through setup before selecting the environment. PM owns freshness;
# activation does not maintain a second dependency stamp. It trusts the
# recorded tool digest instead of re-hashing every entry. `zeus pm
# install` and `zeus update` keep that check.
# ============================================================================
_ZEUS_REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Options: `--test-extras a,b` selects the test environment's runtime extras
# (default: [all]); `--` ends options.
# A bare `source ./activate` inherits the caller's positional parameters.
# Ignore unrelated words so scripts with their own arguments can source it.
_zeus_test_env="--test-environment"
_zeus_expect_extras=""
for _zeus_arg in "$@"; do
    if [ -n "$_zeus_expect_extras" ]; then
        _zeus_test_env="--test-environment=$_zeus_arg"
        _zeus_expect_extras=""
        continue
    fi
    case "$_zeus_arg" in
        --) break ;;
        --test-extras) _zeus_expect_extras=1 ;;
        --test-extras=*) _zeus_test_env="--test-environment=${_zeus_arg#--test-extras=}" ;;
        *) : ;;
    esac
done
if [ -n "$_zeus_expect_extras" ]; then
    printf '%s\n' 'activate: --test-extras needs a comma-separated list' >&2
    unset _zeus_arg _zeus_test_env _zeus_expect_extras
    return 2 2>/dev/null || exit 2
fi
unset _zeus_arg _zeus_expect_extras

# shellcheck source=scripts/_activation.sh
. "$_ZEUS_REPO/scripts/_activation.sh"

if ! zeus_sync "$_ZEUS_REPO" "$_zeus_test_env"; then
    printf '%s\n' 'activate: setup failed; shell environment unchanged' >&2
    unset _zeus_test_env
    return 1 2>/dev/null || exit 1
fi
unset _zeus_test_env

# Guard against double-sourcing: venv activate precedent (re-activating is a
# no-op re-save; we keep it idempotent by deactivating first). Key on the
# function, not the sentinel: child shells inherit __ZEUS_ACTIVATED from an
# activated parent but never the function, and there is nothing to undo there.
if [ "$(type -t deactivate 2>/dev/null)" = "function" ]; then
    deactivate
fi

_zeus_script="$(zeus_compose_env "$_ZEUS_REPO" sh)" || {
    echo "activate: could not compose the environment (see above)" >&2
    unset _zeus_script
    return 1 2>/dev/null || exit 1
}
_zeus_keys="$(printf '%s\n' "$_zeus_script" | sed -n 's/^export \([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p' | tr '\n' ' ')"

# --- snapshot what we are about to change (deactivate restores this) ---
# __ZEUS_ACTIVATED is part of the composed env below (it carries the
# installed-state path this environment was built from), so it is snapshotted
# and exported with every other key — no separate assignment here.
__ZEUS_SAVED_PATH="$PATH"
for _zeus_k in $_zeus_keys; do
    eval "__ZEUS_SAVED_$_zeus_k=\"\${$_zeus_k+set}\""
    eval "__ZEUS_PRIOR_$_zeus_k=\${$_zeus_k-__ZEUS_UNSET__}"
done
zeus_apply_env "$_zeus_script"

# This checkout, not whichever `zeus` PATH finds. A function beats PATH, an
# alias, and a hashed command, including the MSIX execution alias.
__ZEUS_WORKTREE="$_ZEUS_REPO"
# The branch names the worktree. A checkout cannot share a branch with another.
__ZEUS_WORKTREE_NAME="$(git -C "$_ZEUS_REPO" rev-parse --abbrev-ref HEAD 2>/dev/null || :)"
if [ -z "$__ZEUS_WORKTREE_NAME" ] || [ "$__ZEUS_WORKTREE_NAME" = HEAD ]; then
    __ZEUS_WORKTREE_NAME="$(basename "$_ZEUS_REPO")"
fi
__ZEUS_SAVED_PS1="${PS1-__ZEUS_UNSET__}"
__ZEUS_SAVED_PROMPT_COMMAND="${PROMPT_COMMAND-__ZEUS_UNSET__}"

_zeus_worktree_here() {
    _zeus_top="$(git rev-parse --show-toplevel 2>/dev/null)" || return 1
    [ "$(cd "$_zeus_top" && pwd -P)" = "$(cd "$__ZEUS_WORKTREE" && pwd -P)" ]
}

zeus() {
    _zeus_worktree_here || {
        printf '%s\n' "zeus: $(pwd) is outside $__ZEUS_WORKTREE; refusing (the installed command is hidden while this checkout is active)" >&2
        return 1
    }
    (
        cd "$__ZEUS_WORKTREE" || exit 1
        if [ -n "${PYTHON-}" ]; then
            exec "$PYTHON" zeus "$@"
        elif [ -x .venv/Scripts/python.exe ]; then
            exec .venv/Scripts/python.exe zeus "$@"
        elif [ -x .venv/bin/python ]; then
            exec .venv/bin/python zeus "$@"
        elif [ -x venv/Scripts/python.exe ]; then
            exec venv/Scripts/python.exe zeus "$@"
        elif [ -x venv/bin/python ]; then
            exec venv/bin/python zeus "$@"
        else
            exec python zeus "$@"
        fi
    )
}

_zeus_prompt() {
    if [ "$__ZEUS_SAVED_PS1" = "__ZEUS_UNSET__" ]; then
        _zeus_base_ps1=""
    else
        _zeus_base_ps1="$__ZEUS_SAVED_PS1"
    fi
    if _zeus_worktree_here; then
        PS1="($__ZEUS_WORKTREE_NAME) $_zeus_base_ps1"
    else
        PS1="$_zeus_base_ps1"
    fi
}

if [ -n "${PROMPT_COMMAND-}" ]; then
    PROMPT_COMMAND="_zeus_prompt; ${PROMPT_COMMAND}"
else
    PROMPT_COMMAND=_zeus_prompt
fi
_zeus_prompt

deactivate() {
    export PATH="$__ZEUS_SAVED_PATH"
    for _zeus_k in $__ZEUS_KEY_LIST; do
        eval "_zeus_was=\"\$__ZEUS_SAVED_$_zeus_k\""
        eval "_zeus_old=\"\$__ZEUS_PRIOR_$_zeus_k\""
        if [ "$_zeus_was" != "set" ]; then
            unset "$_zeus_k"
        else
            export "$_zeus_k=$_zeus_old"
        fi
        unset "__ZEUS_SAVED_$_zeus_k" "__ZEUS_PRIOR_$_zeus_k"
    done
    if [ "$__ZEUS_SAVED_PS1" = "__ZEUS_UNSET__" ]; then
        unset PS1
    else
        PS1="$__ZEUS_SAVED_PS1"
    fi
    if [ "$__ZEUS_SAVED_PROMPT_COMMAND" = "__ZEUS_UNSET__" ]; then
        unset PROMPT_COMMAND
    else
        PROMPT_COMMAND="$__ZEUS_SAVED_PROMPT_COMMAND"
    fi
    unset __ZEUS_SAVED_PATH __ZEUS_KEY_LIST __ZEUS_ACTIVATED \
          __ZEUS_WORKTREE __ZEUS_WORKTREE_NAME \
          __ZEUS_SAVED_PS1 __ZEUS_SAVED_PROMPT_COMMAND
    unset -f deactivate zeus _zeus_worktree_here _zeus_prompt
    unset _zeus_k _zeus_was _zeus_old _zeus_top
}

# remember the key list for deactivate (kept out of the loop vars above)
__ZEUS_KEY_LIST="$_zeus_keys"

# The composition library is not part of the user's shell.
unset -f zeus_sync zeus_bootstrap_python zeus_compose_env zeus_apply_env \
         zeus_activation_current zeus_ensure_env
unset _ZEUS_REPO _zeus_script _zeus_keys _zeus_k _zeus_top
